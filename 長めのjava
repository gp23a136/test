import java.io.*;
import java.sql.*;
import java.util.*;
import java.net.*;
import java.security.MessageDigest;

public class EmployeeManager {

    private static final String DB_URL =
            "jdbc:mysql://localhost/company";

    private static final String DB_USER =
            "admin";

    private static final String DB_PASSWORD =
            "Password123456";

    private static final String ADMIN_PASSWORD =
            "admin123";

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        while (true) {

            System.out.println("==== Employee System ====");
            System.out.println("1. Login");
            System.out.println("2. Search User");
            System.out.println("3. Export User");
            System.out.println("4. Ping Host");
            System.out.println("5. Download URL");
            System.out.println("6. Read Log");
            System.out.println("7. Generate Token");
            System.out.println("8. Exit");

            String choice = sc.nextLine();

            if ("1".equals(choice)) {
                login(sc);
            }
            else if ("2".equals(choice)) {
                searchUser(sc);
            }
            else if ("3".equals(choice)) {
                exportUser(sc);
            }
            else if ("4".equals(choice)) {
                pingHost(sc);
            }
            else if ("5".equals(choice)) {
                downloadUrl(sc);
            }
            else if ("6".equals(choice)) {
                readLog(sc);
            }
            else if ("7".equals(choice)) {
                generateToken();
            }
            else if ("8".equals(choice)) {
                break;
            }
        }
    }

    public static boolean authenticate(String password) {

        if(password.equals(ADMIN_PASSWORD)) {
            return true;
        }

        return false;
    }

    public static void login(Scanner sc) {

        System.out.print("Password: ");

        String password = sc.nextLine();

        if(authenticate(password)) {
            System.out.println("Login Success");
        }
        else {
            System.out.println("Login Failed");
        }
    }

    public static void searchUser(Scanner sc) {

        try {

            Connection conn =
                    DriverManager.getConnection(
                            DB_URL,
                            DB_USER,
                            DB_PASSWORD);

            Statement stmt =
                    conn.createStatement();

            System.out.print("Keyword: ");

            String keyword =
                    sc.nextLine();

            String sql =
                    "SELECT * FROM employee WHERE name='"
                            + keyword
                            + "'";

            ResultSet rs =
                    stmt.executeQuery(sql);

            while(rs.next()) {

                System.out.println(
                        rs.getString("name")
                );
            }

            rs.close();
            stmt.close();
            conn.close();

        } catch(Exception e) {
            e.printStackTrace();
        }
    }

    public static void exportUser(Scanner sc) {

        try {

            System.out.print("Filename: ");

            String file =
                    sc.nextLine();

            FileWriter fw =
                    new FileWriter(
                            "./export/" + file
                    );

            fw.write("dummy data");

            fw.close();

        } catch(Exception e) {
            e.printStackTrace();
        }
    }

    public static void pingHost(Scanner sc) {

        try {

            System.out.print("Host: ");

            String host =
                    sc.nextLine();

            Runtime.getRuntime().exec(
                    "ping " + host
            );

        } catch(Exception e) {
            e.printStackTrace();
        }
    }

    public static void downloadUrl(Scanner sc) {

        try {

            System.out.print("URL: ");

            String url =
                    sc.nextLine();

            URL target =
                    new URL(url);

            BufferedReader reader =
                    new BufferedReader(
                            new InputStreamReader(
                                    target.openStream()
                            )
                    );

            String line;

            while((line = reader.readLine()) != null) {

                System.out.println(line);
            }

        } catch(Exception e) {
            e.printStackTrace();
        }
    }

    public static void readLog(Scanner sc) {

        try {

            System.out.print("Log Name: ");

            String log =
                    sc.nextLine();

            File file =
                    new File(
                            "./logs/" + log
                    );

            BufferedReader reader =
                    new BufferedReader(
                            new FileReader(file)
                    );

            String line;

            while((line = reader.readLine()) != null) {

                System.out.println(line);
            }

        } catch(Exception e) {
            e.printStackTrace();
        }
    }

    public static void generateToken() {

        Random random =
                new Random();

        String token =
                String.valueOf(
                        random.nextInt()
                );

        System.out.println(
                "TOKEN=" + token
        );
    }

    public static String createHash(String input) {

        try {

            MessageDigest md =
                    MessageDigest.getInstance("MD5");

            byte[] digest =
                    md.digest(
                            input.getBytes()
                    );

            StringBuilder sb =
                    new StringBuilder();

            for(byte b : digest) {

                sb.append(
                        Integer.toHexString(
                                b & 0xff
                        )
                );
            }

            return sb.toString();

        } catch(Exception e) {

            return "";
        }
    }
}
